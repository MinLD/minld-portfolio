NODE_ENV=production
PORT=4000

# Replace with the final HTTPS website origin.
FRONTEND_URL=https://portfolio.example.com
CORS_ORIGIN=https://portfolio.example.com

JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

POSTGRES_USER=minld
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=minld_pfl

ACCESS_TOKEN_SECRET=replace-with-at-least-64-random-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-64-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=minld_pfl_access
REFRESH_TOKEN_COOKIE_NAME=minld_pfl_refresh
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=MinLD

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MinLD.PFL <no-reply@example.com>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_MAX_FILE_SIZE_BYTES=5242880
